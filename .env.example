PORT=3000
PUBLIC_SITE_URL=http://localhost:3000

# Only set when an explicitly trusted reverse proxy overwrites X-Forwarded-For
# with one validated client IP. Separate trusted proxy peer IPs with commas.
TRUSTED_PROXY_IPS=

# Optional: an OpenAI-compatible chat-completions API. Keep credentials server-side.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: send RFQ submissions to an HTTPS webhook. The integration is disabled until configured.
RFQ_WEBHOOK_URL=
RFQ_WEBHOOK_TOKEN=
